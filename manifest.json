{
  "name": "instagram-downloader",
  "description": "Chrome-extension for downloading photos and videos from Instagram",
  "version": "1.0",
  "manifest_version": 3,
  "icons": {
    "16": "icons/favicon16.png",
    "32": "icons/favicon32.png",
    "48": "icons/favicon48.png",
    "128": "icons/favicon128.png"
  },
  "permissions": [
      "activeTab",
      "downloads"
  ],

  "content_scripts": [
    {
        "js": ["index.js"],
        "css": ["instagram-downloader.css"],
        "matches": [
        "https://www.instagram.com/*"
        ],
        "run_at": "document_start"
    }
  ],   
  "web_accessible_resources": [
    {
      "resources": ["injectedScripts.js" ],
      "matches": [ "https://www.instagram.com/*"],
      "run_at": "document_start"
    }
  ]
}
